GROQ_API_KEY=
# Optional: extra Groq keys (comma separated) used when the primary key is rate limited
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low (default, fast), medium or high
GROQ_REASONING_EFFORT=low
# Optional fallback provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TAVILY_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: rate limit + cross-instance generation lock. If set but unreachable,
# anonymous generation requests are refused in production (fail closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required in production: shared secret for the cron/admin generation trigger.
# Set the same value in Vercel env vars and GitHub Actions secrets (sent as a Bearer token).
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Private Analytics Dashboard (ANL-00) ---
# Generate with: openssl rand -base64 24  (use ≥ 20 random chars)
ANALYTICS_PASSWORD=
# Generate with: openssl rand -base64 32  (32-byte HMAC key for daily visitor hash)
ANALYTICS_SALT_SECRET=
# Set to "1" to enable analytics event collection in local dev (disabled by default)
NEXT_PUBLIC_ANALYTICS_DEV=
# Neon plan storage limit in MB for the dashboard's storage report (warns at 80%). Default 512 (Free plan).
NEON_STORAGE_LIMIT_MB=

# --- Reliability and cost controls (all optional; defaults shown) ---
# Max full generation runs per UTC day across all callers (spending cap)
GENERATION_DAILY_LIMIT=6
# Timeouts in milliseconds
DB_TIMEOUT_MS=10000
GROQ_TIMEOUT_MS=45000
# Stop requesting more story sections after this long, and publish what exists
GROQ_SECTIONS_BUDGET_MS=170000
# Skip the Gemini fallback if Groq failed later than this into the run
GEMINI_FALLBACK_CUTOFF_MS=150000

# --- Monitoring ---
# Slack or Discord incoming-webhook URL for alerts (generation failures, budget
# exhausted, server errors, rate limiter down). Leave empty to only log.
ALERT_WEBHOOK_URL=

# Slack app for the read-only /gazette slash command (see README, "Slack
# commands"). The signing secret is under Basic Information > App Credentials.
# SLACK_ALLOWED_USERS: comma-separated Slack member IDs (U…) allowed to run it;
# everyone else is refused and shown their own ID.
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USERS=

# Evidence / fact-check tuning (all optional)
# "advanced" returns query-relevant passages (2 Tavily credits per search); "basic" costs 1.
TAVILY_SEARCH_DEPTH=advanced
# Characters of cleaned snippet shown to the models. Raising it costs Groq tokens/minute.
SNIPPET_CHARS=450
# News results with a published date older than this are dropped.
MAX_RESULT_AGE_DAYS=3

# News sources. "auto" (default): free sources (publisher RSS, Hacker News, GitHub) first, Tavily only
# tops up when they return fewer than MIN_FREE_ARTICLES articles. "free": never call Tavily.
# "tavily": skip the free sources.
NEWS_SOURCES=auto
MIN_FREE_ARTICLES=8
# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour (no scopes needed).
GITHUB_TOKEN=

# Optional: a separate Gemini model for the analytics dashboard AI summary and ask box
# (useful when GEMINI_MODEL is often overloaded). Unset = use GEMINI_MODEL.
GEMINI_ANALYTICS_MODEL=

# --- Analytics extras (all optional) ---
# Google Search Console panel: a service account added as a user on the property.
# GSC_SERVICE_ACCOUNT_JSON is the key file contents (raw JSON or base64).
# GSC_SITE_URL is the property exactly as Search Console lists it, e.g. sc-domain:example.com
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
# Scheduled digest (daily 07:00 UTC cron in vercel.json). A Slack/Discord webhook; falls back to ALERT_WEBHOOK_URL.
ANALYTICS_DIGEST_WEBHOOK_URL=
# Digest by email through Resend. All three are needed.
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
# Monthly Tavily credits of your plan, for the API usage panel (default 1000).
TAVILY_MONTHLY_CREDITS=
